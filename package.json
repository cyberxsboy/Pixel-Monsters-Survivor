{
  "name": "pixel-monsters-survivor",
  "version": "1.0.0",
  "private": true,
  "description": "精灵幸存者 · 可部署到 Cloudflare 的像素幸存者类小游戏",
  "scripts": {
    "start": "node server.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
